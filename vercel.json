{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "DIRECT_URL=\"${DIRECT_URL:-${DATABASE_URL_UNPOOLED:-$DATABASE_URL}}\" npm run db:generate && npm run build -w client && npm run build -w server",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": { "includeFiles": "{client/dist/**,server/dist/**}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/w/:path*", "destination": "/api" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
