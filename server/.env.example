# Copy this file to `server/.env` and replace the placeholders with real values.
# Never commit the real `.env` file.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hint_darling?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate. On serverless hosts
# (e.g. Vercel Postgres/Neon) point DATABASE_URL at the pooler and this at the
# direct URL. Locally it is usually the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/hint_darling?schema=public"

# Port the Express API listens on.
PORT=3002

# Secret used to HMAC six-digit signup codes before they are stored. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET="replace-with-a-random-value-of-at-least-32-characters"

# Brevo transactional email. An API key and a verified sender address are
# required in every environment; registration fails with a 502 when any are
# missing. Create the key at https://app.brevo.com/settings/keys/api and verify
# the sender under Settings -> Senders, Domains, IPs -> Senders. A domain is not
# required, but Brevo may rewrite free-email senders for deliverability.
BREVO_API_KEY="replace-with-your-brevo-api-key"
BREVO_FROM_EMAIL="nuralyaanrishm@gmail.com"
BREVO_FROM_NAME="hintdarling"
# Override only if Brevo instructs you to use a different API host.
# BREVO_BASE_URL="https://api.brevo.com"

# Google OAuth. Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this authorised
# redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID="replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"
# Optional. Defaults to the request origin plus /api/auth/google/callback.
# Set this in production (for example https://hintdarling.com/api/auth/google/callback).
# GOOGLE_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"

# ToyyibPay one-time Pro unlock (RM1 for unlimited gifts per account).
# Use https://dev.toyyibpay.com for sandbox and https://toyyibpay.com for live.
# Callbacks cannot reach localhost; expose the API with a tunnel (e.g. ngrok)
# and put that public URL in TOYYIBPAY_CALLBACK_URL while testing locally.
TOYYIBPAY_BASE_URL="https://toyyibpay.com"
TOYYIBPAY_SECRET_KEY="replace-with-your-toyyibpay-secret-key"
TOYYIBPAY_CATEGORY_CODE="replace-with-your-toyyibpay-category-code"
TOYYIBPAY_CALLBACK_URL="https://hintdarling.vercel.app/api/public/toyyibpay/callback"
TOYYIBPAY_RETURN_URL="https://hintdarling.vercel.app/billing/return"
# 1 = FPX only, 2 = FPX + card. Default is 2.
# TOYYIBPAY_PAYMENT_CHANNEL="2"
# Leave blank to charge ToyyibPay fees to the bill owner, or "0" to charge FPX to the payer.
# TOYYIBPAY_CHARGE_TO_CUSTOMER=""
