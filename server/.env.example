# Copy this file to `server/.env` and replace the placeholders with real values.
# Never commit the real `.env` file.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hint_darling?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate. On serverless hosts
# (e.g. Vercel Postgres/Neon) point DATABASE_URL at the pooler and this at the
# direct URL. Locally it is usually the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/hint_darling?schema=public"

# Port the Express API listens on.
PORT=3002

# Secret used to HMAC six-digit signup codes before they are stored. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET="replace-with-a-random-value-of-at-least-32-characters"

# Brevo transactional email. An API key and a verified sender address are
# required in every environment; registration fails with a 502 when any are
# missing. Create the key at https://app.brevo.com/settings/keys/api and verify
# the sender under Settings -> Senders, Domains, IPs -> Senders. A domain is not
# required, but Brevo may rewrite free-email senders for deliverability.
BREVO_API_KEY="replace-with-your-brevo-api-key"
BREVO_FROM_EMAIL="nuralyaanrishm@gmail.com"
BREVO_FROM_NAME="Hint, Darling"
# Override only if Brevo instructs you to use a different API host.
# BREVO_BASE_URL="https://api.brevo.com"
