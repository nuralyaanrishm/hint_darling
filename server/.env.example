# Copy this file to `server/.env` and replace the placeholders with real values.
# Never commit the real `.env` file.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hint_darling?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate. On serverless hosts
# (e.g. Vercel Postgres/Neon) point DATABASE_URL at the pooler and this at the
# direct URL. Locally it is usually the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/hint_darling?schema=public"

# Port the Express API listens on.
PORT=3002

# Secret used to HMAC six-digit signup codes before they are stored. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET="replace-with-a-random-value-of-at-least-32-characters"

# Mailgun transactional email. A private API key and sender are required in
# every environment; registration fails with a 502 when any are missing.
# Sandbox domains only deliver to recipients listed under Authorized Recipients
# in the Mailgun dashboard.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="sandbox6849f27a01e6422899b034fe42ac6c8e.mailgun.org"
MAILGUN_FROM_EMAIL="postmaster@sandbox6849f27a01e6422899b034fe42ac6c8e.mailgun.org"
MAILGUN_FROM_NAME="Hint, Darling"
# Set this to the EU endpoint if your Mailgun account is in the EU region.
# MAILGUN_BASE_URL="https://api.eu.mailgun.net"
